# ============================================================
#  AI-FIT  —  Root Docker Compose Production Variables
#  Copy to .env, fill every value, run: sh scripts/check-env.sh production
# ============================================================

# --- PostgreSQL ---
DB_PORT=5432
POSTGRES_USER=aifitdb_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_32+CHARS
POSTGRES_DB=aifitdb

# --- HTTP / networking ---
HTTP_PORT=80

# --- Frontend build arg (must be /api for same-origin reverse-proxy) ---
VITE_API_BASE=/api
