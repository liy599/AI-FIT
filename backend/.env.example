APP_ENV=development
DB_AUTO_INIT=1
SECRET_KEY=dev-secret-change-me
JWT_SECRET_KEY=dev-jwt-secret-change-me
DATABASE_URL=postgresql+psycopg://aifitguard:aifitguard@localhost:5432/aifitguard
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=
REDIS_URL=
ADMIN_EMAIL=
DATA_ENCRYPTION_KEY=
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
PASSWORD_RESET_DEBUG_RETURN_LINK=0
UPLOAD_PUBLIC_PREFIXES=avatars,blog_covers
UPLOAD_SIGNED_URL_TTL_SECONDS=300
RATE_LIMIT_ENABLED=1
AUTH_LOGIN_RATE_LIMIT_PER_IP=20
AUTH_LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300
AUTH_LOGIN_RATE_LIMIT_PER_ACCOUNT=8
AUTH_LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900
AUTH_FORGOT_RATE_LIMIT_PER_IP=10
AUTH_FORGOT_RATE_LIMIT_IP_WINDOW_SECONDS=900
AUTH_FORGOT_RATE_LIMIT_PER_ACCOUNT=5
AUTH_FORGOT_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=1800
FEEDBACK_RATE_LIMIT_PER_IP=20
FEEDBACK_RATE_LIMIT_IP_WINDOW_SECONDS=600
FEEDBACK_RATE_LIMIT_PER_SUBJECT=10
FEEDBACK_RATE_LIMIT_SUBJECT_WINDOW_SECONDS=600
STEPFUN_API_URL=https://api.stepfun.com/v1/chat/completions
STEPFUN_API_KEY=replace-with-your-stepfun-key
STEPFUN_MODEL=step-1v-8k
AI_REPORT_API_URL=https://api.stepfun.com/v1/chat/completions
AI_REPORT_API_KEY=replace-with-your-ai-report-key
AI_REPORT_MODEL=step-1v-8k
AI_REPORT_TIMEOUT_SECONDS=20
POSE_REPORT_AI_ENABLED=1
POSE_REPORT_AI_MODEL=step-1v-8k
POSE_REPORT_AI_TIMEOUT_SECONDS=20
POSE_REPORT_AI_MAX_INPUT_CHARS=12000
POSE_SERVER_INFERENCE_ENABLED=0
POSE_SERVER_INFERENCE_POLL_INTERVAL_SECONDS=2
POSE_POLICY_LIVE_TARGET_FPS=40
POSE_POLICY_LIVE_SESSION_LIMIT_SECONDS=120
POSE_POLICY_OFFLINE_MAX_VIDEO_BYTES=52428800
POSE_POLICY_OFFLINE_ANALYSIS_LIMIT_SECONDS=120
POSE_POLICY_OFFLINE_ANALYSIS_TARGET_FPS=40
POSE_POLICY_OFFLINE_ALLOWED_ACTIONS=squat,pushup,pullup,lateral-raise,bent-over-row
