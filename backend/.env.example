APP_ENV=development
DB_AUTO_INIT=1
SECRET_KEY=local-dev-secret-key-change-me-32chars
JWT_SECRET_KEY=local-dev-jwt-secret-change-me-32chars

# Local host development uses the PostgreSQL container exposed on localhost.
# In docker-compose backend containers, use host `db` instead of `localhost`.
DATABASE_URL=postgresql+psycopg://aifitguard:aifitguard@localhost:5432/aifitguard
DB_POOL_RECYCLE_SECONDS=1800
REDIS_URL=

FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_EMAIL=dev@example.com
DATA_ENCRYPTION_KEY=

# Optional image-based food recognition. Leave empty to disable /api/recognize.
STEPFUN_API_URL=
STEPFUN_API_KEY=
STEPFUN_MODEL=step-1v-8k

PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
PASSWORD_RESET_DEBUG_RETURN_LINK=1
PASSWORD_RESET_EMAIL_SUBJECT=Reset your password
EMAIL_VERIFY_REQUIRED=0
EMAIL_VERIFY_TOKEN_TTL_SECONDS=3600
EMAIL_VERIFY_DEBUG_RETURN_LINK=1
EMAIL_VERIFY_EMAIL_SUBJECT=Verify your email

SMTP_HOST=
SMTP_PORT=587
SMTP_USE_SSL=0
SMTP_USE_TLS=1
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

UPLOAD_PUBLIC_PREFIXES=avatars,blog_covers
UPLOAD_SIGNED_URL_TTL_SECONDS=300

RATE_LIMIT_ENABLED=1
AUTH_LOGIN_RATE_LIMIT_PER_IP=20
AUTH_LOGIN_RATE_LIMIT_IP_WINDOW_SECONDS=300
AUTH_LOGIN_RATE_LIMIT_PER_ACCOUNT=8
AUTH_LOGIN_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=900
AUTH_FORGOT_RATE_LIMIT_PER_IP=10
AUTH_FORGOT_RATE_LIMIT_IP_WINDOW_SECONDS=900
AUTH_FORGOT_RATE_LIMIT_PER_ACCOUNT=5
AUTH_FORGOT_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=1800
AUTH_EMAIL_REQUEST_RATE_LIMIT_PER_ACCOUNT=5
AUTH_EMAIL_REQUEST_RATE_LIMIT_ACCOUNT_WINDOW_SECONDS=3600
BLOG_CREATE_DAILY_LIMIT_PER_USER=10

AI_REPORT_API_URL=
AI_REPORT_API_KEY=
AI_REPORT_MODEL=
AI_REPORT_TIMEOUT_SECONDS=20

POSE_POLICY_VERSION=2026-05-04.v1
POSE_POLICY_OFFLINE_MAX_VIDEO_BYTES=52428800
POSE_POLICY_OFFLINE_ANALYSIS_LIMIT_SECONDS=120
POSE_POLICY_OFFLINE_ANALYSIS_TARGET_FPS=40
POSE_POLICY_OFFLINE_ALLOWED_ACTIONS=squat,pushup,lateral-raise,bent-over-row
POSE_POLICY_TRACKING_QUALITY_MIN=0.28
POSE_POLICY_TEMPO_FAST_THRESHOLD_SECONDS=0.4
POSE_POLICY_SQUAT_KNEE_FORWARD_WARN_RATIO=0.045
POSE_POLICY_SQUAT_KNEE_FORWARD_FAIL_RATIO=0.058
POSE_POLICY_SQUAT_KNEE_FORWARD_FAIL_MIN_FRAMES=2
POSE_POLICY_SQUAT_FORWARD_LEAN_WARN_DEG=40
POSE_POLICY_SQUAT_FORWARD_LEAN_FAIL_DEG=55
POSE_POLICY_SQUAT_FORWARD_LEAN_FAIL_MIN_FRAMES=5
POSE_POLICY_PUSHUP_BODY_LINE_WARN_RATIO=0.20
POSE_POLICY_PUSHUP_BODY_LINE_FAIL_RATIO=0.45
POSE_POLICY_PUSHUP_DEPTH_WARN_RATIO=0.20
POSE_POLICY_PUSHUP_DEPTH_FAIL_RATIO=0.45
POSE_POLICY_LATERAL_RAISE_TORSO_SWAY_WARN_RATIO=0.12
POSE_POLICY_LATERAL_RAISE_TORSO_SWAY_FAIL_RATIO=0.35
POSE_POLICY_LATERAL_RAISE_SYMMETRY_WARN_RATIO=0.12
POSE_POLICY_LATERAL_RAISE_SYMMETRY_FAIL_RATIO=0.35
POSE_POLICY_BENT_OVER_ROW_BACK_ANGLE_WARN_DEG=35
POSE_POLICY_BENT_OVER_ROW_BACK_ANGLE_FAIL_DEG=50
POSE_POLICY_BENT_OVER_ROW_RANGE_WARN_RATIO=0.12
POSE_POLICY_BENT_OVER_ROW_RANGE_FAIL_RATIO=0.35
