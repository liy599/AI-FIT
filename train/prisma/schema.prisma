generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String           @id @default(cuid())
  email     String           @unique
  name      String?
  passwordHash String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  trainings TrainingSession[]
  exercises Exercise[]
  categories ExerciseCategory[]
  analysis  AnalysisTask[]
  videos    VideoAsset[]
  settings  UserSettings?
  sessions  Session[]
}

model UserSettings {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  saveOriginalVideos Boolean @default(false)
  videoTtlDays       Int?
  cameraMirror       Boolean @default(true)
  cameraZoom         Float   @default(1)
  cameraViewportWidth Int    @default(420)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model Exercise {
  id        String   @id @default(cuid())
  name      String
  isBuiltin Boolean  @default(false)
  movementType ExerciseMovementType @default(strength)
  categoryId String?
  category   ExerciseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sets TrainingSet[]
  analysisTasks AnalysisTask[]

  @@index([categoryId])
  @@index([userId])
  @@unique([userId, categoryId, name])
}

enum ExerciseMovementType {
  strength
  cardio
  reps_only
  duration_only
  stretch
  tabata
}

model ExerciseCategory {
  id        String   @id @default(cuid())
  name      String
  isBuiltin Boolean  @default(false)
  sortOrder Int      @default(0)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    ExerciseCategory?  @relation("ExerciseCategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  ExerciseCategory[] @relation("ExerciseCategoryTree")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exercises Exercise[]

  @@index([userId, parentId, sortOrder])
  @@unique([userId, parentId, name])
}

model TrainingSession {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime      @default(now())
  endedAt   DateTime?
  note      String?
  report    Json?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  sets      TrainingSet[]

  @@index([userId, startedAt])
}

model TrainingSet {
  id         String          @id @default(cuid())
  trainingId String
  training   TrainingSession @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  order      Int
  reps       Int
  weight     Float?
  note       String?
  createdAt  DateTime        @default(now())

  @@index([trainingId, order])
  @@index([exerciseId])
}

enum AnalysisTaskStatus {
  queued
  running
  succeeded
  failed
}

enum AnalysisViewAngle {
  unknown
  front
  side
  back
}

model VideoAsset {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  keepOriginal Boolean  @default(true)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())

  tasks        AnalysisTask[]

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model AnalysisTask {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      AnalysisTaskStatus @default(queued)
  videoAssetId String?
  videoAsset  VideoAsset?       @relation(fields: [videoAssetId], references: [id], onDelete: SetNull)
  exerciseId  String?
  exercise    Exercise?         @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  viewAngle   AnalysisViewAngle @default(unknown)
  instruction String?
  startedAt   DateTime?
  finishedAt  DateTime?
  errorMessage String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  results     AnalysisResult[]

  @@index([userId, createdAt])
  @@index([status, updatedAt])
  @@index([videoAssetId])
  @@index([exerciseId])
}

model AnalysisResult {
  id        String     @id @default(cuid())
  taskId    String
  task      AnalysisTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  report    Json
  createdAt DateTime   @default(now())

  @@index([taskId, createdAt])
}
